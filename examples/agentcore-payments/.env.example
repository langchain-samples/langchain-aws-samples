# AWS and Amazon Bedrock
AWS_REGION=us-west-2
MODEL_ID=us.anthropic.claude-sonnet-4-6

# One-time Coinbase CDP setup inputs
USER_ID=test-user-001
LINKED_EMAIL=
COINBASE_API_KEY_ID=
COINBASE_API_KEY_SECRET=
COINBASE_WALLET_SECRET=

# Generated by setup_agentcore_payments.ipynb; leave blank initially
PAYMENT_MANAGER_ARN=
PAYMENT_MANAGER_ID=
PAYMENT_CONNECTOR_ID=
CREDENTIAL_PROVIDER_NAME=
CREDENTIAL_PROVIDER_ARN=
INSTRUMENT_ID=
WALLET_ADDRESS=
CONTROL_PLANE_ROLE_ARN=
MANAGEMENT_ROLE_ARN=
PROCESS_PAYMENT_ROLE_ARN=
RESOURCE_RETRIEVAL_ROLE_ARN=

# This example defaults to Base Sepolia. Do not switch to mainnet unless you
# intend to make payments with assets that have real-world value.
NETWORK=ETHEREUM
PAID_API_URL=https://x402-test.genesisblock.ai/api/market-news

# AWS-region LangSmith (required). Step 4 creates this standalone tracing
# project; dataset experiment traces remain under Datasets & Experiments.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://aws.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentcore-payments
