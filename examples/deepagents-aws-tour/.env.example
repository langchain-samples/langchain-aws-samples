# Shared AWS + LangSmith settings
AWS_REGION=us-east-1
# Optional: override the Bedrock model the graph uses (defaults to Haiku 4.5).
# AGENT_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://aws.api.smith.langchain.com
LANGSMITH_API_KEY=

# Tour-specific outputs
LANGSMITH_PROJECT=deepagents-aws-tour
BEDROCK_KB_ID=
AGENT_FILES_BUCKET=
PUBLIC_SUPPORT_DOC_KEY=public-docs/sh-hub-v2-troubleshooting.html

# AgentCore Gateway + Cognito outputs from scripts/register_gateway.py
GATEWAY_URL=
COGNITO_TOKEN_URL=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
MCP_TRANSPORT=streamable_http

# Optional hosted AWS LangSmith UI deploy runtime credentials are not listed here.
# If you choose that path, scripts/create_deployment_user_key.py appends
# AWS_DEFAULT_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, and AWS_SESSION_TOKEN.

# Optional hosted deploy settings
DEPLOYMENT_URL=
DEPLOYMENT_GRAPH=support_tour
